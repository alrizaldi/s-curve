# Environment variables for S-Curve Project Monitoring System

# Supabase Configuration
# Get these values from your Supabase project settings under "Project Settings" -> "API"
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database URL
# Get this value from your Supabase project settings under "Database" -> "Connection string" -> "Direct connection"
DATABASE_URL=your_database_connection_string

# Example values (replace with your actual Supabase project values)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-api-settings
# DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-region-1.aws.supabase.com:5432/postgres